#!/usr/bin/env bash
set -euo pipefail

JARVIS_REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$JARVIS_REPOSITORY_ROOT"
JARVIS_PYTHON="$JARVIS_REPOSITORY_ROOT/.venv/bin/python"
JARVIS_RUFF="$JARVIS_REPOSITORY_ROOT/.venv/bin/ruff"
export PYTHONDONTWRITEBYTECODE=1

if [[ "$(git branch --show-current)" != "main" ]]; then
    echo "[jarvis-pre-push] Solo se trabaja y publica desde main." >&2
    exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
    echo "[jarvis-pre-push] Haz commit de todo antes de comprobar el árbol de trabajo." >&2
    exit 1
fi
if [[ ! -x "$JARVIS_PYTHON" || ! -x "$JARVIS_RUFF" ]]; then
    echo "[jarvis-pre-push] Ejecuta uv sync --locked --group dev primero." >&2
    exit 1
fi

JARVIS_CHECKED_HEAD="$(git rev-parse HEAD)"
JARVIS_SOURCE_BEFORE="$("$JARVIS_PYTHON" -B script/test_resource_guard.py fingerprint \
    --repo-root "$JARVIS_REPOSITORY_ROOT")"
git diff --check
"$JARVIS_RUFF" check --no-cache src tests script
"$JARVIS_PYTHON" -B script/check_clean_base.py
JARVIS_SOURCE_AFTER="$("$JARVIS_PYTHON" -B script/test_resource_guard.py fingerprint \
    --repo-root "$JARVIS_REPOSITORY_ROOT")"
if [[ "$(git rev-parse HEAD)" != "$JARVIS_CHECKED_HEAD" \
      || "$JARVIS_SOURCE_BEFORE" != "$JARVIS_SOURCE_AFTER" ]]; then
    echo "[jarvis-pre-push] HEAD, el índice o las fuentes cambiaron durante los controles; repítelos." >&2
    exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
    echo "[jarvis-pre-push] El árbol dejó de estar limpio durante los controles." >&2
    exit 1
fi
echo "[jarvis-pre-push] Controles estáticos aprobados; validación completa pendiente de CI remota."
