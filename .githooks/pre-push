#!/usr/bin/env bash
set -euo pipefail

JARVIS_REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$JARVIS_REPOSITORY_ROOT"
JARVIS_PYTHON="$JARVIS_REPOSITORY_ROOT/.venv/bin/python"
JARVIS_RUFF="$JARVIS_REPOSITORY_ROOT/.venv/bin/ruff"

if [[ "$(git branch --show-current)" != "main" ]]; then
    echo "[jarvis-pre-push] Solo se publica desde main." >&2
    exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
    echo "[jarvis-pre-push] Haz commit de todo antes de comprobar el árbol de trabajo." >&2
    exit 1
fi
if [[ ! -x "$JARVIS_PYTHON" || ! -x "$JARVIS_RUFF" ]] || ! command -v uv >/dev/null; then
    echo "[jarvis-pre-push] Ejecuta uv sync --locked --group dev primero." >&2
    exit 1
fi

JARVIS_CHECKED_REVISION="$(git rev-parse HEAD)"
JARVIS_GATE_TEMP_ROOT="${TMPDIR:-/tmp}"
if [[ "$(uname -s)" == Darwin ]]; then JARVIS_GATE_TEMP_ROOT=/private/tmp; fi
JARVIS_ARTIFACT_DIRECTORY="$(mktemp -d "$JARVIS_GATE_TEMP_ROOT/jarvis-base-gate.XXXXXX")"
cleanup() { rm -rf "$JARVIS_ARTIFACT_DIRECTORY"; }
trap cleanup EXIT

"$JARVIS_PYTHON" script/check_clean_base.py
"$JARVIS_RUFF" check src tests script
"$JARVIS_PYTHON" -m compileall -q src tests script
(
    while IFS= read -r JARVIS_GIT_VARIABLE; do
        unset "$JARVIS_GIT_VARIABLE"
    done < <(git rev-parse --local-env-vars)
    "$JARVIS_PYTHON" -m pytest -q
)
uv build --offline --sdist --out-dir "$JARVIS_ARTIFACT_DIRECTORY"
JARVIS_SDISTS=("$JARVIS_ARTIFACT_DIRECTORY"/*.tar.gz)
if [[ ${#JARVIS_SDISTS[@]} -ne 1 || ! -f "${JARVIS_SDISTS[0]}" ]]; then
    echo "[jarvis-pre-push] El build no produjo exactamente un sdist." >&2
    exit 1
fi
# Build from the fresh source archive, never a checkout's stale build/lib cache.
uv build --offline --wheel "${JARVIS_SDISTS[0]}" --out-dir "$JARVIS_ARTIFACT_DIRECTORY"
JARVIS_WHEELS=("$JARVIS_ARTIFACT_DIRECTORY"/*.whl)
if [[ ${#JARVIS_WHEELS[@]} -ne 1 || ! -f "${JARVIS_WHEELS[0]}" ]]; then
    echo "[jarvis-pre-push] El build no produjo exactamente un wheel." >&2
    exit 1
fi
"$JARVIS_PYTHON" script/check_clean_base.py --wheel "${JARVIS_WHEELS[0]}" \
    --sdist "${JARVIS_SDISTS[0]}" --smoke

if [[ "$(uname -s)" == Darwin ]]; then
    ./script/test_desktop.sh
    ./script/build_desktop.sh --output "$JARVIS_ARTIFACT_DIRECTORY/native"
fi

if [[ "$(git rev-parse HEAD)" != "$JARVIS_CHECKED_REVISION" \
      || -n "$(git status --porcelain)" ]]; then
    echo "[jarvis-pre-push] El árbol o HEAD cambió durante la cualificación; repítela." >&2
    exit 1
fi
echo "[jarvis-pre-push] Controles automatizados aprobados; paridad completa aún pendiente."
