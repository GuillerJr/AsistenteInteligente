#!/usr/bin/env bash
set -euo pipefail

JARVIS_REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$JARVIS_REPOSITORY_ROOT"
JARVIS_PYTHON="$JARVIS_REPOSITORY_ROOT/.venv/bin/python"
JARVIS_RUFF="$JARVIS_REPOSITORY_ROOT/.venv/bin/ruff"

if [[ "$(git branch --show-current)" != "main" ]]; then
    echo "[jarvis-pre-commit] Trabaja en main; no se crean ramas para esta base." >&2
    exit 1
fi
if [[ ! -x "$JARVIS_PYTHON" || ! -x "$JARVIS_RUFF" ]]; then
    echo "[jarvis-pre-commit] Ejecuta uv sync --locked --group dev primero." >&2
    exit 1
fi

git diff --cached --check
"$JARVIS_PYTHON" script/check_clean_base.py
"$JARVIS_RUFF" check src tests script
"$JARVIS_PYTHON" -m compileall -q src tests script
(
    while IFS= read -r JARVIS_GIT_VARIABLE; do
        unset "$JARVIS_GIT_VARIABLE"
    done < <(git rev-parse --local-env-vars)
    "$JARVIS_PYTHON" -m pytest -q
)
echo "[jarvis-pre-commit] Base Python aprobada; Swift se comprueba en pre-push de macOS."
