#!/usr/bin/env bash
set -euo pipefail

AEGIS_REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$AEGIS_REPOSITORY_ROOT"

echo "[aegis-gate] Building and verifying the signed Swift application"
./script/build_and_run.sh --verify

echo "[aegis-gate] Running deterministic local contract qualification"
./script/aegis.sh acceptance-benchmark

echo "[aegis-gate] Running live macOS qualification"
if ! AEGIS_QUALIFICATION_OUTPUT="$(./script/aegis.sh macos-qualification)"; then
    printf '%s\n' "$AEGIS_QUALIFICATION_OUTPUT" >&2
    echo "[aegis-gate] Rejected: live qualification did not complete successfully" >&2
    exit 1
fi
printf '%s\n' "$AEGIS_QUALIFICATION_OUTPUT"

AEGIS_QUALIFICATION_SCORE="$({
    printf '%s\n' "$AEGIS_QUALIFICATION_OUTPUT" \
        | /usr/bin/sed -n 's/.*"score":\([0-9][0-9]*\).*/\1/p'
} | /usr/bin/tail -n 1)"
if [[
    "$AEGIS_QUALIFICATION_SCORE" != "100"
    || "$AEGIS_QUALIFICATION_OUTPUT" != *'"gate_passed":true'*
]]; then
    echo "[aegis-gate] Rejected: macOS qualification score must be 100" >&2
    exit 1
fi

echo "[aegis-gate] Qualification passed"
