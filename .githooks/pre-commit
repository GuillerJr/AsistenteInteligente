#!/usr/bin/env bash
set -euo pipefail

AEGIS_REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$AEGIS_REPOSITORY_ROOT"
AEGIS_PYTHON="$AEGIS_REPOSITORY_ROOT/.venv/bin/python"
AEGIS_RUFF="$AEGIS_REPOSITORY_ROOT/.venv/bin/ruff"

if [[ "$(git branch --show-current)" != "main" ]]; then
    echo "[aegis-pre-commit] Trabaja en main; no se crean ramas para esta base." >&2
    exit 1
fi
if [[ ! -x "$AEGIS_PYTHON" || ! -x "$AEGIS_RUFF" ]]; then
    echo "[aegis-pre-commit] Ejecuta uv sync --locked --group dev primero." >&2
    exit 1
fi

git diff --cached --check
"$AEGIS_PYTHON" script/check_clean_base.py
"$AEGIS_RUFF" check src tests script
"$AEGIS_PYTHON" -m compileall -q src tests script
(
    while IFS= read -r AEGIS_GIT_VARIABLE; do
        unset "$AEGIS_GIT_VARIABLE"
    done < <(git rev-parse --local-env-vars)
    "$AEGIS_PYTHON" -m pytest -q
)
echo "[aegis-pre-commit] Base Python aprobada; aplicación nativa pendiente."
